# Template only. Copy to .env locally; never commit credentials.
# Blank values are deliberate: no live model or credential selected.
OPENAI_API_KEY=

OPENAI_MODEL=

# Model/tier must exist in this versioned price catalog. Review prices before use.
OPENAI_PRICING_FILE=pricing.json
OPENAI_SERVICE_TIER=default
# Redacted audit JSONL; relative paths are resolved against the project root.
AUDIT_LOG_PATH=logs/audit.jsonl

# Agent limits may be lowered only; canonical settings appear below.
PERMISSION_POLICY=ask_on_write
MAX_OUTPUT_TOKENS=350
OPENAI_TIMEOUT_SECONDS=30
# Both SDK and application retries are disabled, including 429.
# Explicit opt-in for the optional PAID pytest integration test; keep off.
RUN_LIVE_OPENAI=0

# Paths relative to the project root; no database is created on import.
SQLITE_PATH=data/smartsupport.db
FAQ_PATH=data/faq.json
SEED_ORDERS_PATH=data/seed_orders.json
TRACES_DIR=traces

# One local MCP server. CLI identity/session and paths are explicit launch args.
MCP_TRANSPORT=stdio
MCP_SERVER_PATH=mcp_server.py
LOG_LEVEL=INFO

# Streamlit defaults to Demo. Live is NEVER enabled by the browser alone.
SMARTSUPPORT_DEPLOYMENT=public
SMARTSUPPORT_ENABLE_LOCAL_LIVE=0
# Public deployment lock; Render also enforces this using its RENDER=true marker.
SMARTSUPPORT_PUBLIC_DEMO_ONLY=0
# Optional loopback-only convenience for local Demo previews; keep disabled elsewhere.
SMARTSUPPORT_LOCAL_DEMO_BYPASS=0
SMARTSUPPORT_MAX_WORKERS=4
# Visitor idle timeout in seconds (30 minutes). Set in the server process before startup.
SMARTSUPPORT_VISITOR_IDLE_SECONDS=1800
# Optional trusted operator path; relative to project when Streamlit is run there.
SMARTSUPPORT_WEB_DATA_DIR=data/web_demo

MAX_AGENT_TURNS=4
MAX_INPUT_TOKENS=3000
MAX_TOOL_CALLS=3
MAX_HISTORY_MESSAGES=6
MAX_TOOL_RESULT_CHARS=2000
MAX_TASK_COST_USD=0.005
MAX_DAILY_COST_USD=0.10
MAX_API_RETRIES=0
DAILY_COST_DB_PATH=data/daily_api_cost.sqlite3
