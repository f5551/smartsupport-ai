# Default deny: COPY . . receives only application sources and public fixtures.
**
!/*.py
!/requirements.txt
!/pricing.json
!/LICENSE
!/ui/
!/ui/**
!/assets/
!/assets/**
!/data/
!/data/faq.json
!/data/seed_orders.json
!/.streamlit/
!/.streamlit/config.toml

# Defense in depth: these exclusions override every allow rule above.
**/.env*
**/secrets.*
**/credentials*
**/*credentials*.json
**/id_rsa*
**/id_ed25519*
**/id_ecdsa*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.db-journal
**/.git
**/.git/**
**/.venv
**/.venv/**
**/venv
**/venv/**
**/__pycache__
**/__pycache__/**
**/*cache*
**/*.py[cod]
**/.runtime
**/.runtime/**
**/backups
**/backups/**
**/.backup
**/.backup/**
**/*.jsonl
**/*.log
**/*.tmp
**/*.temp
**/*.bak
**/*.zip
**/*.tar
**/*.gz
**/*.7z
**/*.rar
**/*.lock
